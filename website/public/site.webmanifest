{
  "name": "Spaceman",
  "short_name": "Spaceman",
  "description": "A tiling window manager for macOS. Every window side by side, nothing on top of anything else.",
  "start_url": "./",
  "display": "browser",
  "theme_color": "#0a0b0d",
  "background_color": "#0a0b0d",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
