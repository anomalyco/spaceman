#!/usr/bin/env bash
# Keeps /Applications/Pane.app on the tip of main (and cleanly replaces any legacy Spaceman.app).
# Every 30 s it checks origin/main with `git ls-remote`; once main has moved and then stayed put
# for QUIET seconds (pushes come in bursts, so one build covers them all, and a busy stretch
# builds anyway after MAXWAIT), it builds a signed Pane.app bundle in its own worktree and
# installs it with `install-app.sh --wait-idle`, so the restart, which restores and re-tiles
# every window, waits until the keyboard and mouse are idle.
# Run it from a LaunchAgent; scripts/install-updater sets that up.
set -uo pipefail
WT=${PANE_UPDATER_WT:-${SPACEMAN_UPDATER_WT:-$HOME/code/worktrees/spaceman/updater}}
STATE=$HOME/.local/share/spaceman
STAMP=$STATE/installed-rev
# ~/bin first: its cargo wrapper sends the build through HiveMind.
export PATH="$HOME/bin:$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
QUIET=${PANE_UPDATER_QUIET:-${SPACEMAN_UPDATER_QUIET:-180}}
MAXWAIT=${PANE_UPDATER_MAXWAIT:-${SPACEMAN_UPDATER_MAXWAIT:-600}}
IDLE=${PANE_UPDATER_IDLE:-${SPACEMAN_UPDATER_IDLE:-120}}
mkdir -p "$STATE"
cd "$WT" || exit 1
remote_head() { git ls-remote origin refs/heads/main 2>/dev/null | cut -f1; }
while true; do
  head=$(remote_head)
  if [ -n "$head" ] && [ "$head" != "$(cat "$STAMP" 2>/dev/null)" ]; then
    quiet=0 waited=0
    while [ "$quiet" -lt "$QUIET" ] && [ "$waited" -lt "$MAXWAIT" ]; do
      sleep 30
      now=$(remote_head)
      if [ -n "$now" ] && [ "$now" != "$head" ]; then head=$now; quiet=0; else quiet=$((quiet + 30)); fi
      waited=$((waited + 30))
    done
    echo "$(date '+%H:%M:%S') main is ${head:0:7}, building"
    if git fetch -q origin main && git checkout -q -f --detach "$head" \
      && bundle=$(scripts/build-app.sh | tail -n 1) \
      && echo "$(date '+%H:%M:%S') built ${head:0:7}; installing once idle for ${IDLE}s" \
      && scripts/install-app.sh --bundle "$bundle" --wait-idle "$IDLE" >/dev/null; then
      echo "$head" > "$STAMP"
      echo "$(date '+%H:%M:%S') installed ${head:0:7}"
    else
      echo "$(date '+%H:%M:%S') build or install of ${head:0:7} failed; retrying on the next push"
      echo "$head" > "$STAMP.failed"
      # Don't spin on a broken commit: wait for main to move.
      while [ "$(remote_head)" = "$head" ]; do sleep 30; done
    fi
  fi
  sleep 30
done
